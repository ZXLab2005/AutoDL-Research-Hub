{
  "name": "autodl-research-hub",
  "displayName": "AutoDL 研究台",
  "description": "可迁移的独立研究工作区，连接 AutoDL SSH 与 Codex。",
  "version": "1.3.0",
  "license": "MIT",
  "publisher": "local-research",
  "engines": { "vscode": "^1.96.0" },
  "main": "./src/extension.js",
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "受限模式仅展示研究台和使用说明。SSH、终端、网络检查、配置与登录操作需要通过 VS Code 正常流程信任工作区。"
    }
  },
  "contributes": {
    "commands": [
      { "command": "researchHub.open", "title": "AutoDL：打开研究台" },
      { "command": "researchHub.connect", "title": "AutoDL：连接远程研究目录", "enablement": "isWorkspaceTrusted" },
      { "command": "researchHub.ssh", "title": "AutoDL：打开项目终端", "enablement": "isWorkspaceTrusted" }
    ]
  },
  "scripts": { "test": "node --test tests/*.test.js" }
}
